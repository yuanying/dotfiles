Host boucherie.oeilvert.org
  HostName boucherie.oeilvert.org
  StrictHostKeyChecking accept-new
  Port 3222
  User yuanying

Host anietta.oeilvert.org
  HostName anietta.oeilvert.org
  StrictHostKeyChecking accept-new
  Port 3222
  User yuanying

Host mosh.fraction.jp
  HostName mosh.fraction.jp
  User yuanying
  Port 3222
  SetEnv TERM=xterm-256color

Host *.oeilvert.org
  SetEnv TERM=xterm-256color

Host *.leaping.dev
  SetEnv TERM=xterm-256color

Host github.com
  HostName ssh.github.com
  Port 443
  User git
  IdentitiesOnly yes
  # 使った鍵を agent に載せる。devbox から `ssh -A` で入った先でも GitHub に
  # 入れるようにするため。全体ではなくここだけにして、転送先に渡る鍵を
  # GitHub の鍵に絞る。
  AddKeysToAgent yes
