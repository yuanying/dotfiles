#!/bin/sh
# 標準入力をホスト端末 (macOS) のクリップボードへ送る macOS pbcopy 相当。
#
# mosh / ssh 越しのコンテナには X も Wayland も無いので、xsel や wl-copy は
# 使えない。かわりに OSC 52 (端末のクリップボード書き込みエスケープ) を
# 端末まで届ける。経路は次の通りで、実測でどの段も OSC 52 を素通しする。
#
#   コンテナのプロセス -> herdr -> mosh-server -> mosh-client -> Ghostty
#
# Ghostty は clipboard-write が既定で許可なので設定変更は要らない。iTerm2 に
# 乗り換えた場合は "Applications in terminal may access clipboard" が要る。
#
# 制御シーケンスは stdout ではなく /dev/tty へ書く。パイプの途中で使っても
# 端末に届き、かつコピー内容が後続のコマンドに混ざらないため。
set -eu

# mosh は OSC 52 のペイロードを base64 で 16379 バイトまでしか運ばず、
# 超えた分は警告なしで切り捨てる (mosh 1.4.0 で実測)。切れた base64 は
# 端末側でデコードに失敗するか、途中までの壊れた文字列がクリップボードに
# 載るので、黙って渡さずにここで弾く。
MAX_BASE64_BYTES=16379

b64=$(base64 | tr -d '\r\n')

if [ ${#b64} -gt ${MAX_BASE64_BYTES} ]; then
    cat >&2 <<EOF
pbcopy: 入力が大きすぎるためコピーしなかった (base64 ${#b64} > ${MAX_BASE64_BYTES} バイト)
pbcopy: 元データで 12282 バイトが上限。head -c 12282 などで削るか、
pbcopy: ファイルに書き出してホスト側から読むこと。
EOF
    exit 1
fi

printf '\033]52;c;%s\007' "${b64}" > /dev/tty
