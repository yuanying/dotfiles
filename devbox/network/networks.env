# The docker networks every devbox host has, as far as they are the same on
# every host -- which is everything except the IPv6 side of v6net. That part is
# in hosts/<hostname>.env. See README.md in this directory.

# The devbox's own network. Its IPv6 subnet is a global /64 routed to the host,
# so the devbox gets an address the internet can reach (docs/adr/0001).
V6NET_NAME=v6net
V6NET_IPV4_SUBNET=172.18.0.0/16
V6NET_IPV4_GATEWAY=172.18.0.1

# The bridge the sd containers live on, and the devbox joins as its second
# network. IPv4 only: nothing on it needs to be reachable from outside, since
# proxyd in the devbox is the way in.
SDNET_NAME=sdnet
SDNET_SUBNET=172.30.0.0/24
SDNET_GATEWAY=172.30.0.1
