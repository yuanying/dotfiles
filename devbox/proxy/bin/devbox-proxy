#!/usr/bin/env bash
#
# Bring the devbox's public HTTPS proxy up and down.
#
# entrypoint.sh calls `start` on every boot, so the important property is that
# nothing here can stop the devbox from coming up: no declaration file is a
# skip, not a failure. Unlike the version this replaces, a missing certificate
# is not even worth mentioning -- certificates arrive on their own now
# (docs/adr/0006).
#
# Process management lives here and nothing else does. The binary has `serve`,
# `status` and `check`; everything this needs to know about it is a file
# (docs/adr/0008).

set -euo pipefail

PROXY_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

STATE=${DEVBOX_PROXY_STATE:-${HOME}/.config/devbox-proxy}

# Per host, the way ~/.zshrc.<hostname> already is: anietta and boucherie
# publish different services. The unnamed file is the fallback.
default_config() {
    local named=${PROXY_DIR}/services.$(hostname -s).yaml
    [[ -f ${named} ]] && echo "${named}" || echo "${PROXY_DIR}/services.yaml"
}

CONFIG=${DEVBOX_PROXY_CONFIG:-$(default_config)}

HTTP_PORT=${DEVBOX_PROXY_HTTP_PORT:-80}
HTTPS_PORT=${DEVBOX_PROXY_HTTPS_PORT:-443}

# Only needed to hand the binary cap_net_bind_service after a build. Overridable
# so the tests, which use unprivileged ports, never reach for it.
SUDO=${DEVBOX_PROXY_SUDO-sudo}

SRC=${PROXY_DIR}/proxyd
RUN=${STATE}/run
LOG=${STATE}/log
PIDFILE=${RUN}/devbox-proxyd.pid

# The build lands under the state directory, keyed by the checkout it came
# from: a worktree holds different sources and must not share a binary with the
# checkout next to it.
checkout_key() {
    printf '%s' "${PROXY_DIR}" | sha256sum | cut -c1-12
}
BINARY=${STATE}/bin/$(checkout_key)/devbox-proxyd

usage() {
    cat <<EOF
usage: $(basename "$0") {start|stop|restart|reload|status|check|build}

  start      build if the sources are newer, then bring the proxy up
  stop       take it down
  restart    stop, then start
  reload     validate, then apply without dropping anything
  status     what is running, when certificates expire, what renewal did last
  check      validate the declaration file and stop
  build      compile the binary and stop

  State lives in ${STATE}; the declaration file is ${CONFIG}.
EOF
}

note() {
    echo "$(basename "$0"): $*" >&2
}

running() {
    [[ -f ${PIDFILE} ]] && kill -0 "$(cat "${PIDFILE}")" 2> /dev/null
}

have_config() {
    if [[ ! -f ${CONFIG} ]]; then
        note "no declaration file at ${CONFIG}"
        return 1
    fi
}

# needs_build is true when there is no binary, or when anything it was built
# from has changed since. This is what keeps `git pull` enough to fix the
# proxy, the way it was when this was all shell (docs/adr/0005).
needs_build() {
    [[ -x ${BINARY} ]] || return 0
    [[ -n $(find "${SRC}" \( -name '*.go' -o -name 'go.mod' -o -name 'go.sum' \) \
        -newer "${BINARY}" -print -quit 2> /dev/null) ]]
}

build() {
    if ! needs_build; then
        return 0
    fi
    if ! command -v go > /dev/null 2>&1; then
        note "go is not installed, so the proxy cannot be built"
        return 1
    fi

    note "building the proxy from ${SRC}"
    mkdir -p "$(dirname "${BINARY}")"
    ( cd "${SRC}" && go build -o "${BINARY}" . )

    # Ports below 1024 need the capability; above them nothing is required,
    # which is also how the tests avoid needing sudo. Running as the user keeps
    # the signing key, the credentials and the certificates ordinarily
    # accessible (docs/adr/0008).
    if (( HTTPS_PORT < 1024 || HTTP_PORT < 1024 )) && [[ -n ${SUDO} ]]; then
        ${SUDO} setcap cap_net_bind_service=+ep "${BINARY}" \
            || note "setcap failed; binding the privileged ports will not work"
    fi
}

start() {
    build || return 1
    if running; then
        note "already running (pid $(cat "${PIDFILE}"))"
        return 0
    fi
    have_config || { note "not starting the proxy"; return 0; }

    mkdir -p "${RUN}" "${LOG}"
    setsid "${BINARY}" serve \
        --config "${CONFIG}" \
        --state "${STATE}" \
        --http-port "${HTTP_PORT}" \
        --https-port "${HTTPS_PORT}" >> "${LOG}/proxy.log" 2>&1 &

    # The binary writes the pid file itself, so waiting for it is how we learn
    # that it got as far as binding its ports.
    local tries=50
    while (( tries-- > 0 )); do
        if running; then
            note "started (pid $(cat "${PIDFILE}"))"
            return 0
        fi
        sleep 0.1
    done

    note "the proxy did not come up; the last few lines of ${LOG}/proxy.log:"
    tail -5 "${LOG}/proxy.log" >&2 || true
    return 1
}

stop() {
    if ! running; then
        note "not running"
        return 0
    fi
    local pid
    pid=$(cat "${PIDFILE}")
    kill -TERM "${pid}" 2> /dev/null || true

    local tries=100
    while (( tries-- > 0 )); do
        if ! running; then
            note "stopped"
            return 0
        fi
        sleep 0.1
    done

    note "it did not stop on its own; killing pid ${pid}"
    kill -KILL "${pid}" 2> /dev/null || true
    rm -f "${PIDFILE}"
}

# reload validates before it signals. SIGHUP is asynchronous, so sending it
# proves nothing; checking first is how a broken file becomes a non-zero exit
# here instead of a surprise in the log (docs/adr/0008). The process validates
# again when it receives the signal, so a file that changes in between still
# cannot take anything down.
reload() {
    build || return 1
    have_config || return 1
    "${BINARY}" check --config "${CONFIG}" --state "${STATE}" > /dev/null || return 1

    if ! running; then
        note "not running; nothing to reload"
        return 0
    fi
    kill -HUP "$(cat "${PIDFILE}")"
    note "reloaded"
}

status() {
    build || return 1
    have_config || return 0
    "${BINARY}" status --config "${CONFIG}" --state "${STATE}"
}

warnings() {
    [[ -x ${BINARY} ]] || return 0
    [[ -f ${CONFIG} ]] || return 0
    "${BINARY}" status --config "${CONFIG}" --state "${STATE}" --warnings
}

check() {
    build || return 1
    have_config || return 1
    "${BINARY}" check --config "${CONFIG}" --state "${STATE}"
}

command=${1:-}
case ${command} in
    start) start ;;
    stop) stop ;;
    restart) stop && start ;;
    reload) reload ;;
    status) status ;;
    warnings) warnings ;;
    check) check ;;
    build) build ;;
    -h | --help | help) usage ;;
    *)
        usage >&2
        exit 2
        ;;
esac
