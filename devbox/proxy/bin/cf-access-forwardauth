#!/usr/bin/env python3
"""Verify the Cloudflare Access JWT, for Traefik's ForwardAuth middleware.

Cloudflare Access authenticates at the edge, but the devbox holds a routable
IPv6 address, so anyone who learns it can open port 443 directly and skip the
edge entirely. On every request it proxies, Access sets Cf-Access-Jwt-Assertion
to a token signed by the team's key; a request that arrives any other way does
not carry one. This service checks that token and answers 200 or 403, and
Traefik forwards the request only on the former. See docs/adr/0003.

Traefik's own JWT middleware is a Traefik Hub feature and is not in the
open-source proxy, which is why this exists at all rather than being six lines
of configuration.

Nothing here is secret: the verification keys are published, and the checks are
the signature, the issuer (this team) and the audience (this application). It
therefore needs no credential of its own, and is deliberately restricted to the
standard library so that it needs no packaging either.

    cf-access-forwardauth --team-domain acme.cloudflareaccess.com [--port 9101]

Traefik calls it as /verify?service=<name>&aud=<application audience tag>.
"""

import argparse
import base64
import hashlib
import hmac
import json
import logging
import sys
import threading
import time
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

ASSERTION_HEADER = "Cf-Access-Jwt-Assertion"

# The response headers Traefik is told to copy onto the proxied request.
EMAIL_HEADER = "X-Devbox-Access-Email"
SUBJECT_HEADER = "X-Devbox-Access-Sub"

# Clocks drift; Access tokens live for hours. A minute of slack costs nothing.
CLOCK_SKEW = 60

# DigestInfo prefix for SHA-256, from RFC 8017 section 9.2 note 1.
SHA256_DIGEST_INFO = bytes.fromhex("3031300d060960864801650304020105000420")

log = logging.getLogger("cf-access-forwardauth")


class Rejected(Exception):
    """A request that will be answered with 403.

    Carries a reason for the log. The reason never reaches the client: telling
    an unauthenticated caller which check it failed only helps it.
    """


def b64url_decode(value: str) -> bytes:
    padding = "=" * (-len(value) % 4)
    try:
        return base64.urlsafe_b64decode(value + padding)
    except Exception as exc:  # noqa: BLE001 - any malformed input lands here
        raise Rejected(f"undecodable base64url: {exc}") from exc


def b64url_int(value: str) -> int:
    return int.from_bytes(b64url_decode(value), "big")


class KeySet:
    """The team's public keys, refetched on a timer.

    Access rotates its signing keys, so the set cannot be read once at startup.
    It is also not fetched per request: that would put a Cloudflare round trip
    in front of every proxied call, and would let a Cloudflare outage take the
    origin down with it. A cached set keeps working across a brief outage, and
    a key genuinely unknown to the cache triggers one refetch (rate-limited) so
    that a rotation is picked up without a restart.
    """

    # Never fetch more often than this, whatever asks. Without it, a token
    # naming a made-up key id is a free way to make this box call Cloudflare,
    # once per request.
    MIN_FETCH_INTERVAL = 10

    def __init__(self, url: str, ttl: int = 300) -> None:
        self._url = url
        self._ttl = ttl
        self._lock = threading.Lock()
        self._keys: dict[str, tuple[int, int]] = {}
        self._fetched_at = 0.0
        self._attempted_at = 0.0

    def _fetch(self) -> None:
        self._attempted_at = time.monotonic()
        with urllib.request.urlopen(self._url, timeout=10) as response:
            document = json.load(response)
        keys = {}
        for key in document.get("keys", []):
            # Only RSA signing keys are usable here; Access publishes nothing
            # else today, and anything else would be rejected downstream anyway.
            if key.get("kty") != "RSA" or "kid" not in key:
                continue
            keys[key["kid"]] = (b64url_int(key["n"]), b64url_int(key["e"]))
        if not keys:
            raise ValueError(f"no usable RSA keys at {self._url}")
        self._keys = keys
        self._fetched_at = time.monotonic()
        log.info("loaded %d signing key(s) from %s", len(keys), self._url)

    def get(self, kid: str) -> tuple[int, int]:
        with self._lock:
            now = time.monotonic()
            stale = now - self._fetched_at > self._ttl
            wanted = not self._keys or stale or kid not in self._keys
            if wanted and now - self._attempted_at >= self.MIN_FETCH_INTERVAL:
                try:
                    self._fetch()
                except Exception as exc:  # noqa: BLE001 - network, DNS, JSON
                    # Fall through: a cached key still verifies fine, and the
                    # interval above keeps this from retrying in a tight loop.
                    log.warning("could not refresh signing keys: %s", exc)
            if kid not in self._keys:
                raise Rejected(f"unknown key id {kid!r}")
            return self._keys[kid]

    def ready(self) -> bool:
        with self._lock:
            if self._keys:
                return True
            try:
                self._fetch()
            except Exception as exc:  # noqa: BLE001
                log.warning("could not load signing keys: %s", exc)
                return False
            return True


def verify_rs256(signing_input: bytes, signature: bytes, modulus: int, exponent: int) -> bool:
    """Check a PKCS#1 v1.5 RSA signature over SHA-256.

    The expected padded block is rebuilt from scratch and compared whole. That
    is the construction with nothing to parse and therefore nothing to be
    lenient about -- the classic RSA signature forgeries all come from a
    verifier that walks the decrypted block and skips over what it does not
    recognise.
    """
    size = (modulus.bit_length() + 7) // 8
    if len(signature) != size:
        return False

    decrypted = pow(int.from_bytes(signature, "big"), exponent, modulus).to_bytes(size, "big")

    digest_info = SHA256_DIGEST_INFO + hashlib.sha256(signing_input).digest()
    padding_length = size - len(digest_info) - 3
    if padding_length < 8:
        return False
    expected = b"\x00\x01" + b"\xff" * padding_length + b"\x00" + digest_info

    return hmac.compare_digest(decrypted, expected)


def verify(token: str, keys: KeySet, issuer: str, audience: str) -> dict:
    """Return the token's claims, or raise Rejected."""
    parts = token.split(".")
    if len(parts) != 3:
        raise Rejected("not a three-part JWT")

    try:
        header = json.loads(b64url_decode(parts[0]))
        claims = json.loads(b64url_decode(parts[1]))
    except (ValueError, TypeError) as exc:
        raise Rejected(f"undecodable JWT: {exc}") from exc
    if not isinstance(header, dict) or not isinstance(claims, dict):
        raise Rejected("JWT header or payload is not an object")

    # Pin the algorithm before anything else. Taking it from the token is how
    # `alg: none` and HS256-signed-with-the-public-key both get in.
    if header.get("alg") != "RS256":
        raise Rejected(f"unexpected alg {header.get('alg')!r}")
    kid = header.get("kid")
    if not isinstance(kid, str):
        raise Rejected("no key id in the JWT header")

    modulus, exponent = keys.get(kid)
    signing_input = f"{parts[0]}.{parts[1]}".encode()
    if not verify_rs256(signing_input, b64url_decode(parts[2]), modulus, exponent):
        raise Rejected("signature does not verify")

    if claims.get("iss") != issuer:
        raise Rejected(f"issued by {claims.get('iss')!r}, not {issuer!r}")

    # `aud` is a string or a list of strings, per RFC 7519. Access sends a list.
    token_audience = claims.get("aud")
    if isinstance(token_audience, str):
        token_audience = [token_audience]
    if not isinstance(token_audience, list) or audience not in token_audience:
        raise Rejected(f"audience {token_audience!r} does not include {audience!r}")

    now = time.time()
    expiry = claims.get("exp")
    if not isinstance(expiry, (int, float)) or now > expiry + CLOCK_SKEW:
        raise Rejected("expired")
    not_before = claims.get("nbf")
    if isinstance(not_before, (int, float)) and now < not_before - CLOCK_SKEW:
        raise Rejected("not valid yet")

    return claims


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    # Set by serve() before the server starts.
    keys: KeySet
    issuer: str

    def do_GET(self) -> None:  # noqa: N802 - BaseHTTPRequestHandler's spelling
        path, _, query = self.path.partition("?")
        if path == "/healthz":
            self.respond(200 if self.keys.ready() else 503)
            return
        if path != "/verify":
            self.respond(404)
            return

        parameters = dict(
            pair.partition("=")[::2] for pair in query.split("&") if pair
        )
        audience = parameters.get("aud", "")
        service = parameters.get("service", "-")

        try:
            if not audience:
                # A generated router always carries one, so this means the
                # configuration is wrong. Refusing is the safe direction.
                raise Rejected("no aud in the forwardAuth address")
            claims = verify(
                self.headers.get(ASSERTION_HEADER, ""), self.keys, self.issuer, audience
            )
        except Rejected as reason:
            log.warning("%s: refused: %s", service, reason)
            self.respond(403)
            return

        email = str(claims.get("email", ""))
        subject = str(claims.get("sub", ""))
        log.info("%s: allowed %s", service, email or subject or "(anonymous)")
        self.respond(200, {EMAIL_HEADER: email, SUBJECT_HEADER: subject})

    # Traefik issues a GET regardless of the original method, but be tolerant.
    do_HEAD = do_GET
    do_POST = do_GET

    def respond(self, status: int, headers: dict | None = None) -> None:
        self.send_response(status)
        for name, value in (headers or {}).items():
            if value:
                self.send_header(name, value)
        self.send_header("Content-Length", "0")
        self.end_headers()

    def log_message(self, format: str, *args) -> None:  # noqa: A002
        # The default writes to stderr unstructured; everything worth keeping
        # is already logged by do_GET.
        pass


def serve(args: argparse.Namespace) -> int:
    certs_url = args.certs_url or f"https://{args.team_domain}/cdn-cgi/access/certs"
    Handler.keys = KeySet(certs_url, ttl=args.jwks_ttl)
    Handler.issuer = args.issuer or f"https://{args.team_domain}"

    server = ThreadingHTTPServer((args.address, args.port), Handler)
    server.daemon_threads = True
    log.info(
        "verifying for %s on %s:%d against %s",
        Handler.issuer,
        args.address,
        args.port,
        certs_url,
    )
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--team-domain", required=True, help="<team>.cloudflareaccess.com")
    parser.add_argument("--address", default="127.0.0.1", help="address to listen on")
    parser.add_argument("--port", type=int, default=9101, help="port to listen on")
    parser.add_argument("--certs-url", help="override the JWKS URL (tests)")
    parser.add_argument("--issuer", help="override the expected issuer (tests)")
    parser.add_argument("--jwks-ttl", type=int, default=300, help="seconds to cache keys")
    args = parser.parse_args()

    logging.basicConfig(
        level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s", stream=sys.stderr
    )
    return serve(args)


if __name__ == "__main__":
    raise SystemExit(main())
