# boucherie 固有の zsh 設定
# ~/.zshrc.boucherie (bin/setup-zsh.sh から symlink)
#
# ホスト共通の設定は zshrc と zsh.d に置く。ここにはこのマシンでしか
# 意味を持たない値だけを書く。
#
# 後方互換のため ~/.zshrc.local も引き続き読まれる。読み込み順はこちらが
# 後なので、同じ変数を両方で設定した場合はこのファイルが勝つ。

# テーマ選択は themes/host.zsh にまとめる。

# sdctl (sd-generate スキル) の既定の接続先は localhost:7860 だが、sd-webui は
# devbox の外のコンテナで動いている。devbox も参加している v6net 上の
# コンテナ名で届ける (devbox/apps/README.md)。
export SDCTL_URL=http://sd-webui:7860

# vim: set ft=zsh :
