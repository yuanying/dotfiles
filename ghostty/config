# Ghostty の設定。
# キーの一覧は `ghostty +show-config --default --docs` か
# https://ghostty.org/docs/config を参照。

clipboard-read = allow
clipboard-write = allow
# theme = chalk
theme = Afterglow
window-padding-balance = true
window-theme = ghostty
background-opacity = 0.85
background-blur-radius = 20
macos-titlebar-style = transparent
keybind = global:ctrl+tab=toggle_visibility

font-family = Monaco
font-family = Hack Nerd Font Mono
font-thicken = true

adjust-cell-height = 5%

# ssh 先に xterm-ghostty の terminfo が無いと、行編集やプロンプトの再描画が
# 壊れる (Delete が効かない、プロンプトが何度も出る)。ssh-terminfo は初回の
# 接続時に terminfo を ssh 先へ入れ、ssh-env は入れられないときに TERM を
# xterm-256color に落として渡す。ここに書かない機能は既定のまま。
shell-integration-features = ssh-terminfo,ssh-env
