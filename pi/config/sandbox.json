{
  "enabled": true,
  "allowWrite": [
    "~/.cache/go-build",
    "~/.cache/golangci-lint",
    "~/pkg/mod",
    "~/go/pkg/mod",
    "~/.npm",
    "~/.cache/node-gyp",
    "~/.cache/pip",
    "~/.cache/uv",
    "~/.cargo/registry",
    "~/.cargo/git",
    "~/.asdf/installs/ruby",
    "~/.local/share/gem",
    "~/.bundle",
    "~/.cache/gem",
    "~/Library/Caches/go-build",
    "~/Library/Caches/pip",
    "~/Library/Caches/uv",
    "~/.local/state/herdr-tasks"
  ],
  "excludedCommands": [
    "herdr",
    "~/bin/herdr-task-worktree",
    "~/.agents/skills/herdr-tasks/scripts/prompt-agent.sh",
    "~/.agents/skills/herdr-tasks/scripts/write-task-agents.sh"
  ]
}
