#!/usr/bin/env bash
#
# Publish an HTTP server running in this devbox, permanently.
#
#   devbox-publish publish --name llama --port 8081 --github-login yuanying
#   devbox-publish unpublish --name llama
#   devbox-publish list
#   devbox-publish where
#
# This is the skill's hands. It edits the declaration file for this host and
# reloads the proxy, and that is the whole of it -- docs/adr/0005 removed the
# third step, so there is no Cloudflare to reconcile, no API token to have or
# not have, and no half-finished state to explain. Publishing either works or
# says why not.
#
# The skill is loaded through ~/.claude/skills/devbox-publish, which is a
# symlink into a dotfiles checkout that is not necessarily ~/dotfiles. Every
# path below is derived from where this file physically is, never from a guess
# about where the checkout was put.

set -euo pipefail

# `cd -P` walks .. physically, so this lands in the real checkout even when the
# skill directory was reached through the symlink that installed it.
SKILL_DIR=$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
DOTFILES=$(cd -P "${SKILL_DIR}/../.." && pwd)

# Overridable so the tests can put a stand-in in the way of the real wrapper.
PROXY_DIR=${DEVBOX_PROXY_DIR:-${DOTFILES}/devbox/proxy}

# One file per host, the way devbox-proxy already does it.
default_config() {
    local named=${PROXY_DIR}/services.$(hostname -s).yaml
    [[ -f ${named} ]] && echo "${named}" || echo "${PROXY_DIR}/services.yaml"
}

CONFIG=${DEVBOX_PROXY_CONFIG:-$(default_config)}

usage() {
    cat <<EOF
usage: $(basename "$0") <command> [options]

  publish --name NAME --port PORT [options]
      --auth required|none    default: required
      --github-login ACCOUNT  may be repeated
      --github-org ORG        may be repeated
      --no-listen-check       do not require the port to be listening yet

  unpublish --name NAME
  list                        what this host publishes
  where                       the checkout and declaration file in use

  Declaration file: ${CONFIG}
EOF
}

note() {
    echo "$(basename "$0"): $*" >&2
}

die() {
    note "$*"
    exit 1
}

step() {
    echo "==> $*"
}

say() {
    echo "    $*"
}

need_tools() {
    local tool
    for tool in yq jq; do
        command -v "${tool}" > /dev/null || die "${tool} is not installed"
    done
    [[ -f ${CONFIG} ]] || die "no declaration file at ${CONFIG}"
}

zone_of() {
    yq -r '.zone // ""' "${CONFIG}"
}

# The proxy connects to 127.0.0.1:<port>, so that is the address worth checking.
# A server bound only to the container's global IPv6 would answer the outside
# world and not the proxy, and this is where that is caught.
port_is_open() {
    (exec 3<> "/dev/tcp/127.0.0.1/$1") 2> /dev/null
}

json_array() {
    if [[ $# -eq 0 ]]; then
        echo '[]'
    else
        printf '%s\n' "$@" | jq -R . | jq -sc .
    fi
}

declared() {
    yq -r "[.services // [] | .[] | select(.name == \"$1\")] | length" "${CONFIG}"
}

# The wrapper validates before it signals and keeps what is running if the file
# does not hold up (docs/adr/0008), so this can simply ask for a reload and
# report what came back.
reload_proxy() {
    step "Reloading the proxy"
    if DEVBOX_PROXY_CONFIG="${CONFIG}" "${PROXY_DIR}/bin/devbox-proxy" reload; then
        say "done"
        return 0
    fi
    say "the proxy kept running with what it had; the declaration file above is written"
    return 1
}

commit_hint() {
    local what=$1 path=${CONFIG#"${DOTFILES}/"}
    step "Next"
    say "git -C ${DOTFILES} add ${path} && git -C ${DOTFILES} commit -m '${what}'"
}

# ---------------------------------------------------------------------------
# publish
# ---------------------------------------------------------------------------

cmd_publish() {
    local name= port= auth=required listen_check=yes
    local logins=() orgs=()

    while [[ $# -gt 0 ]]; do
        case $1 in
            --name) name=$2; shift 2 ;;
            --port) port=$2; shift 2 ;;
            --auth) auth=$2; shift 2 ;;
            --github-login) logins+=("$2"); shift 2 ;;
            --github-org) orgs+=("$2"); shift 2 ;;
            --no-listen-check) listen_check=; shift ;;
            -h | --help) usage; exit 0 ;;
            *) usage >&2; die "unknown option: $1" ;;
        esac
    done

    need_tools

    [[ -n ${name} ]] || die "--name is required"
    [[ -n ${port} ]] || die "--port is required"

    # One DNS label: the wildcard AAAA record covers exactly one level
    # (docs/adr/0006). Namespace in the name instead -- gpu-llama.
    [[ ${name} == *.* ]] &&
        die "${name} is not one label; a service name cannot contain a dot, so namespace in the name instead (gpu-llama)"
    [[ ${name} =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]] ||
        die "${name} is not a single DNS label: lower case letters, digits and hyphens, nothing else"

    # auth.<zone> is where the login itself happens (docs/adr/0007).
    [[ ${name} == auth ]] && die "auth is reserved: it is the host the login page lives on"

    [[ ${port} =~ ^[0-9]+$ ]] || die "--port must be a number, not ${port}"
    [[ ${port} -ge 1 && ${port} -le 65535 ]] || die "--port must be between 1 and 65535"

    [[ ${auth} == required || ${auth} == none ]] ||
        die "--auth is 'required' or 'none', not ${auth}"

    local logins_json orgs_json
    logins_json=$(json_array ${logins[@]+"${logins[@]}"})
    orgs_json=$(json_array ${orgs[@]+"${orgs[@]}"})

    # A service that asks for a login and admits nobody locks out everyone,
    # including whoever ran this. The proxy refuses to start with one; refusing
    # here means the declaration file never gets into that state either.
    if [[ ${auth} == required && ${logins_json} == "[]" && ${orgs_json} == "[]" ]]; then
        die "a service with auth: required needs at least one viewer (--github-login or --github-org)"
    fi

    if [[ -n ${listen_check} ]] && ! port_is_open "${port}"; then
        die "nothing is listening on 127.0.0.1:${port}; start the server first, or pass --no-listen-check"
    fi

    local existed
    existed=$(declared "${name}")

    local zone
    zone=$(zone_of)
    [[ -n ${zone} ]] || die "${CONFIG} does not name a zone"

    step "Publishing ${name}.${zone} -> http://127.0.0.1:${port}"

    ENTRY=$(jq -n \
        --arg name "${name}" \
        --argjson port "${port}" \
        --arg auth "${auth}" \
        --argjson logins "${logins_json}" \
        --argjson orgs "${orgs_json}" '
        {name: $name, port: $port, auth: $auth}
        + (if ($logins | length) > 0 or ($orgs | length) > 0
           then {viewers: (
                   (if ($logins | length) > 0 then {logins: $logins} else {} end)
                   + (if ($orgs | length) > 0 then {github_orgs: $orgs} else {} end))}
           else {} end)')
    NAME=${name}
    export ENTRY NAME

    # Replace rather than append, so running this twice is an update and not a
    # duplicate. The style="" puts the new entry in block form: the file is
    # hand-edited too, and flow style is valid YAML nobody wants to read.
    yq -i '
        .services = ((.services // []) | map(select(.name != strenv(NAME))) + [env(ENTRY)]) |
        (.services[] | select(.name == strenv(NAME)) | ...) style=""' "${CONFIG}"

    if [[ ${existed} -gt 0 ]]; then
        say "updated ${name} in ${CONFIG}"
    else
        say "added ${name} to ${CONFIG}"
    fi

    local reloaded=0
    reload_proxy || reloaded=$?

    commit_hint "Publish ${name}"
    say "then: https://${name}.${zone}"

    return ${reloaded}
}

# ---------------------------------------------------------------------------
# unpublish
# ---------------------------------------------------------------------------

cmd_unpublish() {
    local name=

    while [[ $# -gt 0 ]]; do
        case $1 in
            --name) name=$2; shift 2 ;;
            -h | --help) usage; exit 0 ;;
            *) usage >&2; die "unknown option: $1" ;;
        esac
    done

    need_tools
    [[ -n ${name} ]] || die "--name is required"

    if [[ $(declared "${name}") -eq 0 ]]; then
        die "${name} is not declared in ${CONFIG}; nothing to withdraw"
    fi

    local zone
    zone=$(zone_of)

    step "Withdrawing ${name}.${zone}"

    NAME=${name}
    export NAME
    yq -i '.services = ((.services // []) | map(select(.name != strenv(NAME))))' "${CONFIG}"
    say "removed ${name} from ${CONFIG}"

    local reloaded=0
    reload_proxy || reloaded=$?

    # The name keeps resolving -- the record is a wildcard and always was --
    # but nothing answers on it now, and the certificate simply stops being
    # renewed.
    commit_hint "Withdraw ${name}"

    return ${reloaded}
}

# ---------------------------------------------------------------------------
# reporting
# ---------------------------------------------------------------------------

cmd_list() {
    need_tools

    local zone count
    zone=$(zone_of)
    count=$(yq -r '(.services // []) | length' "${CONFIG}")

    if [[ ${count} -eq 0 ]]; then
        step "This devbox publishes nothing"
        say "declaration file: ${CONFIG}"
        return 0
    fi

    step "Published from ${CONFIG}"
    ZONE=${zone} yq -r '
        (.services // [])[] |
        "    https://" + .name + "." + strenv(ZONE) +
        "  ->  127.0.0.1:" + (.port | tostring) +
        "  (auth: " + (.auth // "required") + ")"' "${CONFIG}"
}

cmd_where() {
    step "Where this is operating"
    say "checkout:         ${DOTFILES}"
    say "proxy:            ${PROXY_DIR}"
    say "declaration file: ${CONFIG}"
    if [[ -f ${CONFIG} ]]; then
        say "zone:             $(zone_of)"
    else
        say "zone:             (no declaration file yet)"
    fi
}

command=${1:-}
shift || true
case ${command} in
    publish) cmd_publish "$@" ;;
    unpublish) cmd_unpublish "$@" ;;
    list) cmd_list "$@" ;;
    where) cmd_where "$@" ;;
    -h | --help | help) usage ;;
    *)
        usage >&2
        exit 2
        ;;
esac
