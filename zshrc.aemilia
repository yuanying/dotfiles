# aemilia 固有の zsh 設定
# ~/.zshrc.aemilia (bin/setup-zsh.sh から symlink)
#
# ホスト共通の設定は zshrc と zsh.d に置く。ここにはこのマシンでしか
# 意味を持たない値だけを書く。
#
# 後方互換のため ~/.zshrc.local も引き続き読まれる。読み込み順はこちらが
# 後なので、同じ変数を両方で設定した場合はこのファイルが勝つ。

# herdr が Lab Fox なので、nvim の配色も揃える (nvim/colors/labfox.lua)。
export NVIM_COLORSCHEME=labfox

# airline の base16 テーマは色を固定せず、今の colorscheme のハイライトから
# 作るので、上の labfox にそのまま従う。
export AIRLINE_THEME=base16

# Claude Code の statusline はカスタムテーマの対象外で、スクリプトが自前で
# 色を出す。claude/statusline-command.sh がこの値でパレットを選ぶ。
# herdr (Lab Fox) と Claude Code のテーマ (custom:labfox) に揃える。
export CLAUDE_STATUSLINE_THEME=labfox

# vim: set ft=zsh :
