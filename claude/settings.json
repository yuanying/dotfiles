{
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh"
  },
  "tui": "default",
  "theme": "custom:solarized",
  "agentPushNotifEnabled": true,
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/gofmt.sh"
          }
        ]
      }
    ]
  }
}
